# Baza danych (PostgreSQL + PostGIS + pgRouting)
POSTGRES_USER=echomesh
POSTGRES_PASSWORD=echomesh
POSTGRES_DB=echomesh
# Host "db" to nazwa usługi z docker-compose (sieć wewnętrzna Dockera)
DATABASE_URL=postgresql://echomesh:echomesh@db:5432/echomesh

# Adres API widziany z PRZEGLĄDARKI (nie z kontenera), dlatego localhost
VITE_API_URL=http://localhost:3000

# Po ilu minutach odczyt czujnika uznajemy za nieaktualny
STALE_MINUTES=60

# Alerty: próg w dB i minimalny odstęp (s) między alertami tego samego czujnika
ALERT_THRESHOLD_DB=75
ALERT_COOLDOWN_SECONDS=60

# Promień strefy wydarzenia (m): hałas w tej odległości od trwającego wydarzenia jest "wytłumaczony"
EVENT_RADIUS_M=300
