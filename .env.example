# Baza danych (PostgreSQL + PostGIS + pgRouting)
POSTGRES_USER=echomesh
POSTGRES_PASSWORD=echomesh
POSTGRES_DB=echomesh
# Host "db" to nazwa usługi z docker-compose (sieć wewnętrzna Dockera)
DATABASE_URL=postgresql://echomesh:echomesh@db:5432/echomesh

# Adres API widziany z PRZEGLĄDARKI (nie z kontenera), dlatego localhost
VITE_API_URL=http://localhost:3000

# Po ilu minutach odczyt czujnika uznajemy za nieaktualny
STALE_MINUTES=60

# Alerty: próg w dB i minimalny odstęp (s) między alertami tego samego czujnika
ALERT_THRESHOLD_DB=75
ALERT_COOLDOWN_SECONDS=60

# Promień strefy wydarzenia (m): hałas w tej odległości od trwającego wydarzenia jest "wytłumaczony"
EVENT_RADIUS_M=300

# Tworzy 3 konta demonstracyjne (mieszkaniec / analityk / admin) przy starcie backendu
SEED_DEMO_USERS=true

# Uwierzytelnianie (JWT). W produkcji ustaw długi, losowy JWT_SECRET!
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag
JWT_EXPIRES_IN_SECONDS=28800

# Chatbot: maksymalna liczba zgłoszeń jednego użytkownika na godzinę
CHAT_MAX_REPORTS_PER_HOUR=10

# LLM do analizy zgłoszeń (API zgodne z OpenAI, np. Groq). Bez klucza chatbot działa w trybie awaryjnym na regułach.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=8000
