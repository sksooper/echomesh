# Baza danych (PostgreSQL + PostGIS + pgRouting)
POSTGRES_USER=echomesh
POSTGRES_PASSWORD=echomesh
POSTGRES_DB=echomesh
# Host "db" to nazwa usługi z docker-compose (sieć wewnętrzna Dockera)
DATABASE_URL=postgresql://echomesh:echomesh@db:5432/echomesh

# Adres API widziany z PRZEGLĄDARKI (nie z kontenera), dlatego localhost
VITE_API_URL=http://localhost:3000
